<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_venta_actual" targetNamespace="https://github.com/paolo2711/electrohogar-ventas">
  <bpmn:collaboration id="Colab_venta_actual">
    <bpmn:participant id="Part_venta_actual" name="Venta en tienda: proceso actual" processRef="Proc_venta_actual" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_venta_actual" isExecutable="false">
    <bpmn:laneSet id="Carriles_venta_actual">
      <bpmn:lane id="Carril_venta_actual_CLI" name="Cliente">
        <bpmn:flowNodeRef>venta_actual_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_venta_actual_VEN" name="Vendedor de piso">
        <bpmn:flowNodeRef>venta_actual_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_venta_actual_CAJ" name="Caja">
        <bpmn:flowNodeRef>venta_actual_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_venta_actual_ALM" name="Almacén">
        <bpmn:flowNodeRef>venta_actual_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_f2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_i2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_actual_f4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="venta_actual_i1" name="Cliente llega a la tienda">
      <bpmn:outgoing>Flujo_venta_actual_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="venta_actual_t1" name="Pide un producto">
      <bpmn:incoming>Flujo_venta_actual_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="venta_actual_t2" name="Revisa la lista de precios impresa">
      <bpmn:incoming>Flujo_venta_actual_2</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="venta_actual_g1" name="¿Cree que hay unidades?">
      <bpmn:incoming>Flujo_venta_actual_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_4</bpmn:outgoing>
      <bpmn:outgoing>Flujo_venta_actual_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="venta_actual_f1" name="Venta perdida">
      <bpmn:incoming>Flujo_venta_actual_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="venta_actual_t3" name="Anota la venta en el talonario">
      <bpmn:incoming>Flujo_venta_actual_4</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="venta_actual_t4" name="Lleva la nota a caja">
      <bpmn:incoming>Flujo_venta_actual_6</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="venta_actual_t5" name="Cobra y emite la boleta">
      <bpmn:incoming>Flujo_venta_actual_7</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="venta_actual_t6" name="Busca el producto en almacén">
      <bpmn:incoming>Flujo_venta_actual_8</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="venta_actual_g2" name="¿Está el producto?">
      <bpmn:incoming>Flujo_venta_actual_9</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_10</bpmn:outgoing>
      <bpmn:outgoing>Flujo_venta_actual_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="venta_actual_t7" name="Entrega el producto">
      <bpmn:incoming>Flujo_venta_actual_10</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="venta_actual_f2" name="Producto entregado">
      <bpmn:incoming>Flujo_venta_actual_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="venta_actual_t8" name="Devuelve el dinero">
      <bpmn:incoming>Flujo_venta_actual_11</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="venta_actual_f3" name="Venta anulada">
      <bpmn:incoming>Flujo_venta_actual_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="venta_actual_i2" name="Cierre del día">
      <bpmn:outgoing>Flujo_venta_actual_14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Tiempo_venta_actual_i2" />
    </bpmn:startEvent>
    <bpmn:manualTask id="venta_actual_t9" name="Actualiza el Excel con las salidas del día">
      <bpmn:incoming>Flujo_venta_actual_14</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_actual_15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="venta_actual_f4" name="Stock actualizado">
      <bpmn:incoming>Flujo_venta_actual_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_venta_actual_1" sourceRef="venta_actual_i1" targetRef="venta_actual_t1" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_2" sourceRef="venta_actual_t1" targetRef="venta_actual_t2" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_3" sourceRef="venta_actual_t2" targetRef="venta_actual_g1" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_4" sourceRef="venta_actual_g1" targetRef="venta_actual_t3" name="Sí" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_5" sourceRef="venta_actual_g1" targetRef="venta_actual_f1" name="No" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_6" sourceRef="venta_actual_t3" targetRef="venta_actual_t4" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_7" sourceRef="venta_actual_t4" targetRef="venta_actual_t5" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_8" sourceRef="venta_actual_t5" targetRef="venta_actual_t6" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_9" sourceRef="venta_actual_t6" targetRef="venta_actual_g2" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_10" sourceRef="venta_actual_g2" targetRef="venta_actual_t7" name="Sí" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_11" sourceRef="venta_actual_g2" targetRef="venta_actual_t8" name="No" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_12" sourceRef="venta_actual_t7" targetRef="venta_actual_f2" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_13" sourceRef="venta_actual_t8" targetRef="venta_actual_f3" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_14" sourceRef="venta_actual_i2" targetRef="venta_actual_t9" />
    <bpmn:sequenceFlow id="Flujo_venta_actual_15" sourceRef="venta_actual_t9" targetRef="venta_actual_f4" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagrama_venta_actual">
    <bpmndi:BPMNPlane id="Plano_venta_actual" bpmnElement="Colab_venta_actual">
