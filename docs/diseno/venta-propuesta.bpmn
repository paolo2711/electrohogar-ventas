<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_venta_propuesta" targetNamespace="https://github.com/paolo2711/electrohogar-ventas">
  <bpmn:collaboration id="Colab_venta_propuesta">
    <bpmn:participant id="Part_venta_propuesta" name="Venta en tienda: proceso con el sistema" processRef="Proc_venta_propuesta" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_venta_propuesta" isExecutable="false">
    <bpmn:laneSet id="Carriles_venta_propuesta">
      <bpmn:lane id="Carril_venta_propuesta_CLI" name="Cliente">
        <bpmn:flowNodeRef>venta_propuesta_i1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_propuesta_t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_venta_propuesta_CAJ" name="Cajero">
        <bpmn:flowNodeRef>venta_propuesta_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_propuesta_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_propuesta_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_propuesta_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_propuesta_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_propuesta_t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_venta_propuesta_SIS" name="Sistema">
        <bpmn:flowNodeRef>venta_propuesta_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_propuesta_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_propuesta_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_propuesta_t9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Carril_venta_propuesta_INV" name="Encargado de inventario">
        <bpmn:flowNodeRef>venta_propuesta_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>venta_propuesta_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="venta_propuesta_i1" name="Cliente elige un producto">
      <bpmn:outgoing>Flujo_venta_propuesta_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="venta_propuesta_t1" name="Busca el producto en el sistema">
      <bpmn:incoming>Flujo_venta_propuesta_1</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="venta_propuesta_t2" name="Muestra precio y stock">
      <bpmn:incoming>Flujo_venta_propuesta_2</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="venta_propuesta_g1" name="¿Hay stock?">
      <bpmn:incoming>Flujo_venta_propuesta_3</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_4</bpmn:outgoing>
      <bpmn:outgoing>Flujo_venta_propuesta_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="venta_propuesta_f1" name="Venta no realizada">
      <bpmn:incoming>Flujo_venta_propuesta_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="venta_propuesta_t3" name="Registra la venta">
      <bpmn:incoming>Flujo_venta_propuesta_4</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="venta_propuesta_t4" name="Paga">
      <bpmn:incoming>Flujo_venta_propuesta_6</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="venta_propuesta_t5" name="Confirma el cobro">
      <bpmn:incoming>Flujo_venta_propuesta_7</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="venta_propuesta_t6" name="Descuenta el stock y registra el movimiento">
      <bpmn:incoming>Flujo_venta_propuesta_8</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="venta_propuesta_g2" name="¿Quedó bajo el mínimo?">
      <bpmn:incoming>Flujo_venta_propuesta_9</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_10</bpmn:outgoing>
      <bpmn:outgoing>Flujo_venta_propuesta_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="venta_propuesta_t9" name="Lo agrega a la lista de reposición">
      <bpmn:incoming>Flujo_venta_propuesta_10</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="venta_propuesta_t7" name="Emite la boleta">
      <bpmn:incoming>Flujo_venta_propuesta_11</bpmn:incoming>
      <bpmn:incoming>Flujo_venta_propuesta_12</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="venta_propuesta_t8" name="Entrega el producto">
      <bpmn:incoming>Flujo_venta_propuesta_13</bpmn:incoming>
      <bpmn:outgoing>Flujo_venta_propuesta_14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="venta_propuesta_f2" name="Producto entregado">
      <bpmn:incoming>Flujo_venta_propuesta_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_1" sourceRef="venta_propuesta_i1" targetRef="venta_propuesta_t1" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_2" sourceRef="venta_propuesta_t1" targetRef="venta_propuesta_t2" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_3" sourceRef="venta_propuesta_t2" targetRef="venta_propuesta_g1" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_4" sourceRef="venta_propuesta_g1" targetRef="venta_propuesta_t3" name="Sí" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_5" sourceRef="venta_propuesta_g1" targetRef="venta_propuesta_f1" name="No" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_6" sourceRef="venta_propuesta_t3" targetRef="venta_propuesta_t4" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_7" sourceRef="venta_propuesta_t4" targetRef="venta_propuesta_t5" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_8" sourceRef="venta_propuesta_t5" targetRef="venta_propuesta_t6" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_9" sourceRef="venta_propuesta_t6" targetRef="venta_propuesta_g2" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_10" sourceRef="venta_propuesta_g2" targetRef="venta_propuesta_t9" name="Sí" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_11" sourceRef="venta_propuesta_g2" targetRef="venta_propuesta_t7" name="No" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_12" sourceRef="venta_propuesta_t9" targetRef="venta_propuesta_t7" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_13" sourceRef="venta_propuesta_t7" targetRef="venta_propuesta_t8" />
    <bpmn:sequenceFlow id="Flujo_venta_propuesta_14" sourceRef="venta_propuesta_t8" targetRef="venta_propuesta_f2" />
  </bpmn:process>
